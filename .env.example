# 胶水层环境配置模板（glue_server.py 内置轻量 .env 加载器，无需 python-dotenv）
# 复制为 .env 后按本机修改。路径占位符 <...> 必须替换；端口按实际部署。
# ⚠️ 这是模板，不是任何机器的配置快照（2026-08-13 补：复现缺口 G8）

# ── 沙漏（明线数据底座）──
# 沙漏源码目录（sandglass_vault.py 所在）
SANDGLASS_SOURCE=<YOUR_LIGHT_HOME>/sandglass_source
# 沙漏数据目录（sandglass.txt 权威源所在）
NEXSANDBASE_HOME=<YOUR_LIGHT_HOME>/sandglass

# ── LMS（暗线塑形）──
LMS_URL=http://localhost:8190

# ── 向量后端（bge-m3，OpenAI 兼容 /v1/embeddings；与 LMS 嵌入同源）──
VECTOR_URL=http://127.0.0.1:11435/v1/embeddings

# ── 自我怀疑总线（Phase 6：doubt.episode -> lms.feed）──
# 指向 agent-os 事件总线权威文件；不设 = 怀疑闭环不发布到总线（自检④会红）
DOUBT_BUS_FILE=<YOUR_AGENT_OS_HOME>/iso-sand/data/event_bus.jsonl
